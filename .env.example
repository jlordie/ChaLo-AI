# Environment: development | production | staging
NODE_ENV=development

# Server Ports
PORT=3000
API_PORT=8000
WS_PORT=8001

# Database Configuration
DATABASE_URL=postgresql://chalo:chalopassword@localhost:5432/chalo_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=10
SESSION_SECRET=your-session-secret-key
SESSION_TIMEOUT=86400

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@chaloai.com
SMTP_FROM_NAME=ChaLo AI

# AI Services & API Keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_ORG_ID=
HUGGINGFACE_API_KEY=your-huggingface-key
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=production
PINECONE_INDEX_NAME=chalo-ai

# AWS Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=chalo-ai-bucket
AWS_COGNITO_USER_POOL_ID=
AWS_COGNITO_CLIENT_ID=

# Google Cloud (Optional)
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8001
NEXT_PUBLIC_APP_NAME=ChaLo AI
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_DSN=

# Admin Configuration
ADMIN_EMAIL=jhonlordvisto101@gmail.com
ADMIN_INITIAL_PASSWORD=

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE=/var/log/chalo-ai/app.log

# File Upload
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx,zip
UPLOAD_DIR=/tmp/uploads

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Feature Flags
FEATURE_AI_CHAT=true
FEATURE_CODE_GENERATION=true
FEATURE_IMAGE_GENERATION=true
FEATURE_AUTOMATION=true
FEATURE_ANALYTICS=true

# Sentry Error Tracking (Optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development