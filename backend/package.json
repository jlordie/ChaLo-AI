{
  "name": "chalo-backend",
  "version": "1.0.0",
  "description": "ChaLo AI Backend API Server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate": "typeorm migration:run -d src/database/data-source.ts",
    "migrate:create": "typeorm migration:create",
    "seed": "ts-node src/database/seed.ts",
    "db:reset": "typeorm schema:drop -d src/database/data-source.ts && npm run migrate"
  },
  "keywords": ["ai", "api", "express", "typescript"],
  "author": "Jhon Lord Visto",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-cors": "^1.0.0",
    "express-jwt": "^8.4.1",
    "express-validator": "^7.0.0",
    "typeorm": "^0.3.16",
    "pg": "^8.11.2",
    "redis": "^4.6.10",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.1",
    "langchain": "^0.0.200",
    "openai": "^4.10.0",
    "winston": "^3.11.0",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.9.0",
    "@types/multer": "^1.4.10",
    "@types/jest": "^29.5.7",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.52.0",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "prettier": "^3.1.0"
  }
}
