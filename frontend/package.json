{
  "name": "chalo-frontend",
  "version": "1.0.0",
  "description": "ChaLo AI Web Application",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "desktop:build": "electron-builder",
    "desktop:dev": "concurrently \"next dev\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:package": "npm run build && electron-builder"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2",
    "@reduxjs/toolkit": "^1.9.7",
    "react-redux": "^8.1.3",
    "axios": "^1.5.0",
    "socket.io-client": "^4.7.1",
    "tailwindcss": "^3.3.5",
    "react-icons": "^4.12.0",
    "zustand": "^4.4.1",
    "react-query": "^3.39.3",
    "framer-motion": "^10.16.4",
    "next-auth": "^4.24.0",
    "chart.js": "^4.4.0",
    "react-chartjs-2": "^5.2.0",
    "react-markdown": "^9.0.0",
    "prismjs": "^1.29.0",
    "next-seo": "^6.4.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.4",
    "react-hook-form": "^7.48.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.28",
    "@types/react-dom": "^18.2.11",
    "@types/node": "^20.9.0",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.31",
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.1.1",
    "prettier": "^3.1.0",
    "eslint": "^8.52.0",
    "eslint-config-next": "^14.0.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4",
    "wait-on": "^7.0.1",
    "concurrently": "^8.2.1"
  }
}
